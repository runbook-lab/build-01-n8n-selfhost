# Copy to /srv/n8n/secrets.env, fill in, then: chmod 600 /srv/n8n/secrets.env
# Generate values with: openssl rand -hex 24  (password)  /  openssl rand -hex 32  (key)
POSTGRES_PASSWORD=change-me
N8N_ENCRYPTION_KEY=change-me
# Keep a copy of N8N_ENCRYPTION_KEY OUTSIDE the server (password manager).
# Without it, a restored n8n refuses to start.

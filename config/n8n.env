# Runbook Lab Build 1 — n8n settings (no secrets in this file; they live in secrets.env, chmod 600)
DB_TYPE=postgresdb
DB_POSTGRESDB_HOST=127.0.0.1
DB_POSTGRESDB_PORT=5432
DB_POSTGRESDB_DATABASE=n8n
DB_POSTGRESDB_USER=n8n
N8N_HOST=n8n.runbook.test
N8N_PORT=5678
N8N_LISTEN_ADDRESS=127.0.0.1
N8N_PROTOCOL=https
N8N_WEBHOOK_URL=https://n8n.runbook.test/
N8N_PROXY_HOPS=1
N8N_USER_FOLDER=/srv/n8n/data
GENERIC_TIMEZONE=Europe/Stockholm
TZ=Europe/Stockholm
N8N_DIAGNOSTICS_ENABLED=false
N8N_VERSION_NOTIFICATIONS_ENABLED=false
